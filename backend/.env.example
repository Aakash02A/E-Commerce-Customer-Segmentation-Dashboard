# Copy to .env and adjust as needed. All values are optional; defaults suit local use.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-for-production
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Storage paths (absolute or relative to project root). Defaults shown.
DATABASE_PATH=database/ecommerce.db
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
EXPORTS_DIR=storage/exports
TEMP_DIR=storage/temp

# Upload limits
MAX_CONTENT_LENGTH=104857600   # 100 MB in bytes
UPLOAD_RETENTION_DAYS=30

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=CustomerSegmentationAnalytics

# Security headers / CSP (Phase 11). Defaults are strict and safe; only change
# if you know what you are doing. See app/services/security_service.py.
SECURITY_HEADERS_ENABLED=1
CDN_ORIGIN=https://cdn.jsdelivr.net
CSP_FRAME_ANCESTORS='none'
X_FRAME_OPTIONS=DENY
REFERRER_POLICY=no-referrer

# Rate limiting (Phase 11). In-memory, PER-PROCESS, per client IP; counters
# reset on restart and are NOT shared between workers/instances.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXPENSIVE=10
RATE_LIMIT_STANDARD=30

# Production servers (Phase 11). run.py is dev-only; use serve.py (Waitress) on
# Windows or Gunicorn (via wsgi:app) on Linux/Docker.
WAITRESS_THREADS=4
# Gunicorn bind/workers/threads/timeout are set in the Dockerfile CMD and the
# DEPLOYMENT.md command (1 worker for the embedded PySpark JVM); there is no
# GUNICORN_BIND env var — pass CLI flags to gunicorn directly.
